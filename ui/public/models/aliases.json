{
 "about": "Lookup from dataset to 3D models for the three.js view. All sizes in metres. GLB axes: x width, y height (up), z depth; model fronts face +Z.",
 "placement_rule": "For each asset: model = assets[type].model ('box' = plain box of the footprint). Scale x by footprint.width_m / model.width_m and z by footprint.depth_m / model.depth_m; scale y by height_m / model.height_m when a height_m override is given, else leave y at 1. Rotate about y by footprint.rotation_deg; position at asset.position on the floor's elevation.",
 "openings_rule": "door with width_m < 1.4 -> 'door'; door with width_m >= 1.4 -> 'door_double'; kind 'opening' with width_m <= 2.5 -> 'opening_frame', wider openings stay plain gaps; kind 'entrance' -> 'entrance'. Scale x to width_m, origin on the wall line at opening.position, front (+Z) toward the room or outside.",
 "spaces_rule": "type 'stair' -> 'stair_dogleg' if the space's bounding box is at most 1.5 times longer than wide, else 'stair_flight'; scale x,z to the bounding box and y by floor.height_m / rise_m. type 'lift' -> 'lift' scaled to the bounding box, one per floor the lift stops at, front toward the space's door.",
